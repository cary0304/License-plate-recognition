      "source": [
        "gray = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY)      #convert to grey scale\n",
        "gray = cv2.bilateralFilter(gray, 11, 17, 17)      #Blur to reduce noise\n",
        "kernel_size = 3\n",
        "blur_gray = cv2.GaussianBlur(gray,(kernel_size, kernel_size), 0)\n",
        "edged = cv2.Canny(blur_gray, 20, 120)                  #Perform Edge detection"
      ]
